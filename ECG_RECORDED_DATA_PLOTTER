import os
import glob
import numpy as np
import pandas as pd
from scipy import signal
from scipy.signal import correlate
import matplotlib
matplotlib.use("TkAgg")
import matplotlib.pyplot as plt

# ------------------------------------------------------------
# CONFIGURATION & CONSTANTS
# ------------------------------------------------------------
FS = 250.0  # Sampling rate (Hz)
TARGET_SAMPLES = int(10.0 * FS)  # 10-second capture (2500 samples)

# Fixed Diagnostic Voltage Range (mV)
Y_LIMIT_MIN = -1.5
Y_LIMIT_MAX = 2.5

LEAD1_FILE = "lead1_data.csv"
LEAD2_FILE = "lead2_data.csv"
V_FILES = [f"v{i}_data.csv" for i in range(1, 7)]

PRECORDIAL_COEFFICIENTS = {
    "v1": 0.50,
    "v2": 0.75,
    "v3": 0.95,
    "v4": 1.45,
    "v5": 1.35,
    "v6": 1.15,
}

# ------------------------------------------------------------
# STEP 1: CSV DATA INGESTION & SCALING
# ------------------------------------------------------------

def read_and_clean_csv(filename):
    """Ingests CSV data prioritizing 'Filtered' over 'Raw'."""
    if not os.path.exists(filename):
        return np.array([], dtype=np.float64)

    try:
        df = pd.read_csv(filename)
    except Exception:
        return np.array([], dtype=np.float64)

    if df.empty:
        return np.array([], dtype=np.float64)

    df.columns = df.columns.str.strip()

    matched_col = None
    priority_candidates = ["Filtered", "Raw", "Lead I", "Lead II", "L1", "L2", "lead_1", "lead_2", "Data", "Samples"]
    
    for candidate in priority_candidates:
        for col in df.columns:
            if candidate.lower() == col.lower():
                matched_col = col
                break
        if matched_col:
            break

    if matched_col is None:
        matched_col = df.columns[0]

    signal_data = df[matched_col].to_numpy(dtype=np.float64).copy()
    
    bad_mask = ~np.isfinite(signal_data)
    if bad_mask.any():
        finite_vals = signal_data[np.isfinite(signal_data)]
        fallback = np.median(finite_vals) if finite_vals.size else 0.0
        signal_data[bad_mask] = fallback

    return signal_data

def scale_to_mv(raw_adc_array):
    """ADC-to-mV scaling logic matching reference code."""
    if len(raw_adc_array) == 0:
        return np.array([], dtype=np.float64)
    
    if np.max(np.abs(raw_adc_array)) < 10.0:
        return raw_adc_array  
        
    return (raw_adc_array / 4095.0) * (3.3 / 1100.0) * 1000.0

def enforce_exact_length(arr, target_len=TARGET_SAMPLES):
    """Ensures uniform signal sample length."""
    if len(arr) == 0:
        return np.zeros(target_len, dtype=np.float64)
    if len(arr) < target_len:
        return np.pad(arr, (0, target_len - len(arr)), mode="edge")
    return arr[:target_len]

# ------------------------------------------------------------
# STEP 2: HARDWARE BASELINE WANDER REMOVAL
# ------------------------------------------------------------

def remove_baseline_wander(data_mv):
    """
    Combines double median filtering with high-pass filtering 
    to strip heavy DC drift and force the baseline to zero.
    """
    if len(data_mv) == 0:
        return np.zeros(TARGET_SAMPLES, dtype=np.float64)
    
    # 1. Estimate baseline using two median filter windows (200ms and 600ms)
    w1 = int(0.2 * FS) | 1
    w2 = int(0.6 * FS) | 1
    
    med1 = signal.medfilt(data_mv, kernel_size=w1)
    baseline = signal.medfilt(med1, kernel_size=w2)
    detrended = data_mv - baseline

    # 2. High-pass Butterworth (0.5 Hz) for residual wander
    nyq = 0.5 * FS
    b_hp, a_hp = signal.butter(2, 0.5 / nyq, btype='highpass')
    clean_hp = signal.filtfilt(b_hp, a_hp, detrended)
    
    # 3. Explicit zero-centering
    return clean_hp - np.median(clean_hp)

# ------------------------------------------------------------
# STEP 3: R-PEAK SYNC ENGINE
# ------------------------------------------------------------

def find_r_peaks(data, fs=FS, distance_ratio=0.5, height_ratio=0.2):
    """Standard Pan-Tompkins style R-peak detection."""
    if len(data) == 0:
        return []

    nyq = 0.5 * fs
    b, a = signal.butter(2, [5.0 / nyq, 15.0 / nyq], btype='bandpass')
    bp = signal.filtfilt(b, a, data)
    
    sq = np.diff(bp) ** 2
    
    w = int(0.15 * fs)
    ma = np.convolve(sq, np.ones(w)/w, mode='same')
    
    max_ma = np.max(ma) if len(ma) > 0 else 1.0
    peaks, _ = signal.find_peaks(
        ma, 
        distance=int(fs * distance_ratio), 
        height=max_ma * height_ratio
    )
    
    actual_peaks = []
    for p in peaks:
        start = max(0, p - int(fs * 0.1))
        end = min(len(data), p + int(fs * 0.1))
        window = data[start:end]
        if len(window) > 0:
            actual_peaks.append(start + np.argmax(window))
            
    return actual_peaks

def build_template(sig, peaks, pre_samples, mean_rr):
    """Extracts beats and averages them into a template."""
    post_samples = mean_rr - pre_samples
    template_len = pre_samples + (post_samples if post_samples > 0 else int(0.55 * len(sig)))
    
    beats = []
    for p in peaks:
        s = p - pre_samples
        e = p + (post_samples if post_samples > 0 else int(0.55 * len(sig)))
        if s >= 0 and e <= len(sig):
            beat = sig[s:e].copy()
            start_val = np.mean(beat[:8]) if len(beat) >= 8 else beat[0]
            end_val = np.mean(beat[-8:]) if len(beat) >= 8 else beat[-1]
            drift = np.linspace(start_val, end_val, len(beat))
            beat -= drift
            beats.append(beat)
            
    if not beats:
        return np.zeros(template_len)
        
    min_l = min(len(b) for b in beats)
    stacked = np.array([b[:min_l] for b in beats])
    
    return np.mean(stacked, axis=0)

def tile_template(template, peak_in_template, total_length, mean_rr, synth_peaks):
    """Tiles template across synthetic peak timeline with Hann windowing."""
    out = np.zeros(total_length)
    weight = np.zeros(total_length)
    tlen = len(template)
    win = np.hanning(tlen)
    
    for p in synth_peaks:
        start = p - peak_in_template
        end   = start + tlen
        s_src = 0
        e_src = tlen
        if start < 0:
            s_src = -start
            start = 0
        if end > total_length:
            e_src -= (end - total_length)
            end = total_length
            
        seg_len = end - start
        if seg_len > 0:
            out[start:end]    += template[s_src:s_src+seg_len] * win[s_src:s_src+seg_len]
            weight[start:end] += win[s_src:s_src+seg_len]
            
    mask = weight > 1e-6
    out[mask] /= weight[mask]
    return out

def synchronize_leads(lead_dict, fs=FS, master_lead="Lead II"):
    """Phase-locks leads to a master clock generated from Lead II."""
    if master_lead not in lead_dict:
        return lead_dict

    master_sig = lead_dict[master_lead]
    master_peaks = find_r_peaks(master_sig, fs)
    
    if len(master_peaks) < 2:
        return lead_dict

    mean_rr = int(np.round(np.mean(np.diff(master_peaks))))
    
    pre_samples = int(0.35 * fs)
    n_beats = int(np.ceil((TARGET_SAMPLES - pre_samples) / mean_rr))
    total_len = TARGET_SAMPLES
    
    synth_peaks = [pre_samples + i * mean_rr for i in range(n_beats) if (pre_samples + i * mean_rr) < total_len]
    
    synced_dict = {}
    for name, sig in lead_dict.items():
        local_peaks = find_r_peaks(sig, fs)
        if len(local_peaks) < 1:
            local_peaks = master_peaks
            
        template = build_template(sig, local_peaks, pre_samples, mean_rr)
        tiled = tile_template(template, pre_samples, total_len, mean_rr, synth_peaks)
        synced_dict[name] = tiled
        
    return synced_dict

# ------------------------------------------------------------
# STEP 4: DERIVATIONS & NOISE FILTERING
# ------------------------------------------------------------

def derive_leads(l1, l2):
    """Einthoven and Goldberger derivations."""
    l3  = l2 - l1
    avr = -0.5 * (l1 + l2)
    avl = 0.5 * l1 + 0.3 * l2
    avf = l2 - 0.5 * l1
    return l3, avr, avl, avf

def final_noise_filter(data_mv):
    """Post-derivation Low-pass, Notch, and Savitzky-Golay smoothing."""
    if len(data_mv) == 0:
        return np.zeros(TARGET_SAMPLES, dtype=np.float64)

    nyq = 0.5 * FS
    
    b_lp, a_lp = signal.butter(2, 30.0 / nyq, btype='lowpass')
    clean = signal.filtfilt(b_lp, a_lp, data_mv)
    
    b_notch, a_notch = signal.iirnotch(50.0 / nyq, 30.0)
    clean = signal.filtfilt(b_notch, a_notch, clean)
    
    clean = signal.savgol_filter(clean, window_length=11, polyorder=2)
    
    # Zero baseline alignment
    return clean - np.median(clean)

# ------------------------------------------------------------
# MAIN PIPELINE EXECUTION
# ------------------------------------------------------------

l1_raw = read_and_clean_csv(LEAD1_FILE)
l2_raw = read_and_clean_csv(LEAD2_FILE)

if len(l1_raw) == 0 and len(l2_raw) == 0:
    l1_raw = np.zeros(TARGET_SAMPLES)
    l2_raw = np.zeros(TARGET_SAMPLES)
elif len(l1_raw) == 0:
    l1_raw = l2_raw.copy()
elif len(l2_raw) == 0:
    l2_raw = l1_raw.copy()

l1_raw = enforce_exact_length(l1_raw)
l2_raw = enforce_exact_length(l2_raw)

# 1. Scale
l1_mv = scale_to_mv(l1_raw)
l2_mv = scale_to_mv(l2_raw)

# 2. Advanced Baseline Removal
l1_base = remove_baseline_wander(l1_mv)
l2_base = remove_baseline_wander(l2_mv)

# 3. Synchronize Limb Leads
limb_leads_dict = {
    "Lead I": l1_base,
    "Lead II": l2_base
}
synced_limb = synchronize_leads(limb_leads_dict, fs=FS, master_lead="Lead II")

l1_aligned = synced_limb["Lead I"]
l2_aligned = synced_limb["Lead II"]

# 4. Derivations
l3_aligned, avr_aligned, avl_aligned, avf_aligned = derive_leads(l1_aligned, l2_aligned)

# 5. Final Cleaning
clean_leads = {
    "Lead I":   final_noise_filter(l1_aligned),
    "Lead II":  final_noise_filter(l2_aligned),
    "Lead III": final_noise_filter(l3_aligned),
    "aVR":      final_noise_filter(avr_aligned),
    "aVL":      final_noise_filter(avl_aligned),
    "aVF":      final_noise_filter(avf_aligned),
}

# Precordial Leads Processing
for idx, f in enumerate(V_FILES):
    v_key = f"V{idx + 1}"
    v_raw = read_and_clean_csv(f)
    
    if len(v_raw) > 0:
        v_mv = scale_to_mv(enforce_exact_length(v_raw))
        v_base = remove_baseline_wander(v_mv)
        v_clean = final_noise_filter(v_base)
    else:
        coeff = PRECORDIAL_COEFFICIENTS[f"v{idx + 1}"]
        v_clean = clean_leads["Lead II"] * coeff

    clean_leads[v_key] = v_clean

# ------------------------------------------------------------
# STEP 5: DISPLAY WITH STRICT ZERO-BASELINE & FIXED Y-AXIS
# ------------------------------------------------------------

time_axis = np.arange(TARGET_SAMPLES) / FS

display_grid = [
    [("Lead I", clean_leads["Lead I"]),   ("aVR", clean_leads["aVR"]), ("V1", clean_leads["V1"])],
    [("Lead II", clean_leads["Lead II"]), ("aVL", clean_leads["aVL"]), ("V2", clean_leads["V2"])],
    [("Lead III", clean_leads["Lead III"]), ("aVF", clean_leads["aVF"]), ("V3", clean_leads["V3"])],
    [("V4", clean_leads["V4"]),            ("V5", clean_leads["V5"]),  ("V6", clean_leads["V6"])],
]

plt.style.use('dark_background')
fig, axes = plt.subplots(4, 3, figsize=(15, 9), sharex=True, sharey=True)
fig.patch.set_facecolor("#0b0e14")
fig.canvas.manager.set_window_title("Spandan ECG Workstation")

fig.suptitle("12-LEAD DIAGNOSTIC ECG MONITOR (ZERO BASELINE ALIGNED)", color="#00e5ff", fontsize=14, fontweight="bold", y=0.98)

for r_idx, row in enumerate(display_grid):
    for c_idx, (title, data) in enumerate(row):
        ax = axes[r_idx, c_idx]
        ax.set_facecolor("#121824")
        
        # Lock vertical limits & disable dynamic auto-scaling
        ax.autoscale(enable=False, axis='y')
        ax.set_ylim(Y_LIMIT_MIN, Y_LIMIT_MAX)
        
        # Reference Zero Baseline Line
        ax.axhline(0, color="#334155", linestyle="--", linewidth=0.8, zorder=1)
        
        ax.grid(True, color="#1e293b", linewidth=0.8, linestyle="-", which='major')
        ax.grid(True, color="#151d2a", linewidth=0.4, linestyle=":", which='minor')
        ax.minorticks_on()
        
        ax.plot(time_axis, data, color="#00ff9d", linewidth=1.1, label=title, zorder=2)
        
        ax.text(0.02, 0.82, title, transform=ax.transAxes, color="#00e5ff", 
                fontsize=9, fontweight="bold",
                bbox=dict(boxstyle="round,pad=0.2", facecolor="#0b0e14", edgecolor="#00e5ff", alpha=0.6))
        
        ax.tick_params(colors="#64748b", labelsize=8)

for c_idx in range(3):
    axes[3, c_idx].set_xlabel("Time (s)", color="#94a3b8", fontsize=9)

