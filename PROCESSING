// =====================================================
// RAW AUTO SCALE
// =====================================================

void updateRawScale() {

  float minValue = 4095;
  float maxValue = 0;


  for (
    int i = 0;
    i < BUFFER_SIZE;
    i++
  ) {

    float v =
      rawData[i];


    minValue =
      min(
        minValue,
        v
      );

    maxValue =
      max(
        maxValue,
        v
      );
  }


  float range =
    maxValue -
    minValue;


  if (range < 5) {
    return;
  }


  float margin =
    range * 0.20;


  float targetMin =
    constrain(
      minValue -
      margin,
      0,
      4095
    );


  float targetMax =
    constrain(
      maxValue +
      margin,
      0,
      4095
    );


  rawMin =
    lerp(
      rawMin,
      targetMin,
      scaleSmooth
    );


  rawMax =
    lerp(
      rawMax,
      targetMax,
      scaleSmooth
    );
}


// =====================================================
// FILTERED AUTO SCALE
// =====================================================

void updateFilteredScale() {

  float minValue =
    999999;

  float maxValue =
    -999999;


  for (
    int i = 0;
    i < BUFFER_SIZE;
    i++
  ) {

    float v =
      filteredData[i];


    minValue =
      min(
        minValue,
        v
      );

    maxValue =
      max(
        maxValue,
        v
      );
  }


  float range =
    maxValue -
    minValue;


  if (range < 5) {
    return;
  }


  float margin =
    range * 0.25;


  float targetMin =
    minValue -
    margin;

  float targetMax =
    maxValue +
    margin;


  filteredMin =
    lerp(
      filteredMin,
      targetMin,
      scaleSmooth
    );


  filteredMax =
    lerp(
      filteredMax,
      targetMax,
      scaleSmooth
    );
}


// =====================================================
// SERIAL EVENT
// =====================================================

void serialEvent(
  Serial p
) {

  String incoming =
    p.readStringUntil('\n');


  if (incoming == null) {
    return;
  }


  incoming =
    trim(incoming);


  // ===================================================
  // LEADS OFF
  // ===================================================

  if (
    incoming.startsWith(">off:")
  ) {

    signalConnected = false;


    if (signalRecording) {

      accumulatedRecordingSeconds +=
        (
          millis() -
          connectionStartMillis
        )
        /
        1000.0;


      signalRecording = false;


      println(
        "ECG DISCONNECTED"
      );

      println(
        "Recording timer PAUSED"
      );
    }


    return;
  }


  // ===================================================
  // RAW
  // ===================================================

  if (
    incoming.startsWith(">raw:")
  ) {

    try {

      float value =
        float(
          incoming.substring(5)
        );


      rawData[dataIndex] =
        value;


      signalConnected = true;

    }
    catch(Exception e) {

      println(
        "RAW error: " +
        incoming
      );
    }


    return;
  }


  // ===================================================
  // FILTERED
  // ===================================================

  if (
    incoming.startsWith(">filtered:")
  ) {

    try {

      float value =
        float(
          incoming.substring(10)
        );


      filteredData[dataIndex] =
        value;


      // =================================================
      // START TIMER ONLY WHEN SIGNAL ARRIVES
      // =================================================

      if (!signalRecording) {

        signalRecording = true;

        signalConnected = true;

        connectionStartMillis =
          millis();

        firstSignalReceived = true;


        println(
          "ECG CONNECTED"
        );

        println(
          "Recording timer STARTED"
        );
      }


      dataIndex++;


      if (
        dataIndex >=
        BUFFER_SIZE
      ) {

        dataIndex = 0;
      }

    }
    catch(Exception e) {

      println(
        "Filtered error: " +
        incoming
      );
    }
  }
}


// =====================================================
// RECORDING TIMER
// =====================================================

void updateRecordingTimer() {

  if (signalRecording) {

    float currentSessionSeconds =
      (
        millis() -
        connectionStartMillis
      )
      /
      1000.0;


    totalRecordingSeconds =
      accumulatedRecordingSeconds +
      currentSessionSeconds;

  }
  else {

    totalRecordingSeconds =
      accumulatedRecordingSeconds;
  }
}


// =====================================================
// FORMAT TIME
// =====================================================

String formatTime(
  float seconds
) {

  int total =
    int(seconds);


  int hours =
    total /
    3600;


  int minutes =
    (
      total %
      3600
    )
    /
    60;


  int secs =
    total %
    60;


  return
    nf(hours, 2)
    +
    ":"
    +
    nf(minutes, 2)
    +
    ":"
    +
    nf(secs, 2);
}


