// =====================================================
// ECG MEASUREMENTS
// =====================================================

void updateECGMeasurements() {

  measurementCounter++;


  if (
    measurementCounter < 15
  ) {
    return;
  }


  measurementCounter = 0;


  ArrayList<Integer> peaks =
    detectRPeaks();


  if (
    peaks.size() < 2
  ) {
    return;
  }


  int r2 =
    peaks.get(
      peaks.size() - 1
    );


  int r1 =
    peaks.get(
      peaks.size() - 2
    );


  rrInterval =
    (
      r2 - r1
    )
    *
    (
      1000.0 /
      SAMPLE_RATE
    );


  if (
    rrInterval > 300 &&
    rrInterval < 2000
  ) {

    heartRate =
      60000.0 /
      rrInterval;
  }


  calculateIntervals(
    r2
  );
}


// =====================================================
// R PEAK DETECTION
// =====================================================

ArrayList<Integer>
detectRPeaks() {

  ArrayList<Integer> peaks =
    new ArrayList<Integer>();


  float minValue =
    999999;

  float maxValue =
    -999999;


  for (
    int i = 0;
    i < BUFFER_SIZE;
    i++
  ) {

    float v =
      getValue(i);


    minValue =
      min(
        minValue,
        v
      );

    maxValue =
      max(
        maxValue,
        v
      );
  }


  float range =
    maxValue -
    minValue;


  if (
    range < 10
  ) {
    return peaks;
  }


  float threshold =
    minValue +
    range *
    0.65;


  int minimumDistance =
    int(
      SAMPLE_RATE *
      0.25
    );


  int lastPeak =
    -minimumDistance;


  for (
    int i = 2;
    i <
      BUFFER_SIZE - 2;
    i++
  ) {

    float current =
      getValue(i);

    float left =
      getValue(i - 1);

    float right =
      getValue(i + 1);


    if (
      current >
      threshold &&

      current >
      left &&

      current >=
      right
    ) {

      if (
        i -
        lastPeak >=
        minimumDistance
      ) {

        peaks.add(i);

        lastPeak = i;
      }
    }
  }


  return peaks;
}


// =====================================================
// INTERVAL CALCULATIONS
// =====================================================

void calculateIntervals(
  int rPeak
) {

  int qrsOnset =
    findQRSOnset(
      rPeak
    );


  int qrsEnd =
    findQRSEnd(
      rPeak
    );


  if (
    qrsOnset < 0 ||
    qrsEnd < 0
  ) {
    return;
  }


  qrsDuration =
    (
      qrsEnd -
      qrsOnset
    )
    *
    (
      1000.0 /
      SAMPLE_RATE
    );


  int pOnset =
    findPOnset(
      qrsOnset
    );


  if (
    pOnset >= 0
  ) {

    prInterval =
      (
        qrsOnset -
        pOnset
      )
      *
      (
        1000.0 /
        SAMPLE_RATE
      );
  }


  int tEnd =
    findTEnd(
      qrsEnd,
      rPeak
    );


  if (
    tEnd >= 0
  ) {

    qtInterval =
      (
        tEnd -
        qrsOnset
      )
      *
      (
        1000.0 /
        SAMPLE_RATE
      );


    float rrSeconds =
      rrInterval /
      1000.0;


    if (
      rrSeconds > 0
    ) {

      qtcInterval =
        (
          qtInterval /
          1000.0
        )
        /
        sqrt(
          rrSeconds
        )
        *
        1000.0;
    }
  }


  measurementsReady = true;
}


// =====================================================
// QRS ONSET
// =====================================================

int findQRSOnset(
  int rPeak
) {

  int start =
    max(
      5,
      rPeak - 25
    );


  float peak =
    abs(
      getValue(
        rPeak
      )
    );


  float threshold =
    peak *
    0.15;


  for (
    int i =
      rPeak - 1;

    i >= start;

    i--
  ) {

    if (
      abs(
        getValue(i)
      )
      <
      threshold
    ) {

      return i;
    }
  }


  return
    rPeak - 15;
}


// =====================================================
// QRS END
// =====================================================

int findQRSEnd(
  int rPeak
) {

  int end =
    min(
      BUFFER_SIZE - 5,
      rPeak + 30
    );


  float peak =
    abs(
      getValue(
        rPeak
      )
    );


  float threshold =
    peak *
    0.15;


  for (
    int i =
      rPeak + 1;

    i <= end;

    i++
  ) {

    if (
      abs(
        getValue(i)
      )
      <
      threshold
    ) {

      return i;
    }
  }


  return
    rPeak + 20;
}


// =====================================================
// P PEAK
// =====================================================

int findPPeak(
  int qrsOnset
) {

  int start =
    max(
      5,
      qrsOnset - 60
    );


  int end =
    max(
      start + 1,
      qrsOnset - 20
    );


  float best =
    -999999;


  int index =
    -1;


  for (
    int i = start;
    i <= end;
    i++
  ) {

    float v =
      abs(
        getValue(i)
      );


    if (
      v > best
    ) {

      best = v;

      index = i;
    }
  }


  return index;
}


// =====================================================
// P ONSET
// =====================================================

int findPOnset(
  int qrsOnset
) {

  int pPeak =
    findPPeak(
      qrsOnset
    );


  if (
    pPeak < 0
  ) {
    return -1;
  }


  float peak =
    abs(
      getValue(
        pPeak
      )
    );


  float threshold =
    peak *
    0.10;


  for (
    int i =
      pPeak - 1;

    i >=
      max(
        0,
        pPeak - 30
      );

    i--
  ) {

    if (
      abs(
        getValue(i)
      )
      <
      threshold
    ) {

      return i;
    }
  }


  return
    pPeak - 20;
}


// =====================================================
// T END
// =====================================================

int findTEnd(
  int qrsEnd,
  int rPeak
) {

  int start =
    qrsEnd + 15;


  int end =
    min(
      BUFFER_SIZE - 5,
      rPeak + 125
    );


  float maxT =
    -999999;


  int tPeak =
    -1;


  for (
    int i = start;
    i <= end;
    i++
  ) {

    float v =
      abs(
        getValue(i)
      );


    if (
      v > maxT
    ) {

      maxT = v;

      tPeak = i;
    }
  }


  if (
    tPeak < 0
  ) {
    return -1;
  }


  float threshold =
    maxT *
    0.10;


  for (
    int i =
      tPeak + 1;

    i <=
      min(
        end,
        tPeak + 50
      );

    i++
  ) {

    if (
      abs(
        getValue(i)
      )
      <
      threshold
    ) {

      return i;
    }
  }


  return
    tPeak + 30;
}


// =====================================================
// GET FILTERED VALUE
// =====================================================

float getValue(
  int position
) {

  int index =
    (
      dataIndex +
      position
    )
    %
    BUFFER_SIZE;


  return
    filteredData[index];
}


// =====================================================
// MOUSE - LEAD SELECTION
// =====================================================

void mousePressed() {

  int y =
    filteredGraphY +
    graphHeight +
    38;


  int buttonX =
    graphX + 48;


  for (
    int i = 0;
    i < leads.length;
    i++
  ) {

    int bw = 65;


    if (
      mouseX >= buttonX &&

      mouseX <=
      buttonX + bw &&

      mouseY >=
      y - 16 &&

      mouseY <=
      y + 8
    ) {

      selectedLead =
        i;


      println(
        "Selected Lead: " +
        leads[i]
      );


      break;
    }


    buttonX +=
      bw + 5;
  }
}


