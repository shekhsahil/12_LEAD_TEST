// =====================================================
// ECG GRID
// =====================================================

void drawECGGrid(
  int y
) {

  float totalTime =
    BUFFER_SIZE /
    SAMPLE_RATE;


  stroke(GRID_MINOR);

  strokeWeight(1);


  for (
    float t = 0;
    t <= totalTime;
    t += 0.2
  ) {

    float x =
      map(
        t,
        0,
        totalTime,
        graphX,
        graphX +
        graphWidth
      );

    line(
      x,
      y,
      x,
      y +
      graphHeight
    );
  }


  stroke(GRID_MAJOR);


  for (
    float t = 0;
    t <= totalTime;
    t += 0.5
  ) {

    float x =
      map(
        t,
        0,
        totalTime,
        graphX,
        graphX +
        graphWidth
      );

    line(
      x,
      y,
      x,
      y +
      graphHeight
    );
  }


  stroke(GRID_MINOR);


  for (
    int yy = y;
    yy <= y +
      graphHeight;
    yy += 25
  ) {

    line(
      graphX,
      yy,
      graphX +
      graphWidth,
      yy
    );
  }


  stroke(GRID_MAJOR);

  line(
    graphX,
    y +
    graphHeight / 2,
    graphX +
    graphWidth,
    y +
    graphHeight / 2
  );
}


