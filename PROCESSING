  // ===================================================

  if (
    key == 'r' ||
    key == 'R'
  ) {

    accumulatedRecordingSeconds = 0;

    totalRecordingSeconds = 0;


    if (
      signalRecording
    ) {

      connectionStartMillis =
        millis();
    }


    println(
      "Recording timer RESET"
    );
  }
}
