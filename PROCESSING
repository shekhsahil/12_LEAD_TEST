// =====================================================
// RAW WAVEFORM
// =====================================================

void drawRawWaveform() {

  stroke(RAW_COLOR);

  strokeWeight(1.5);

  noFill();

  beginShape();


  for (
    int i = 0;
    i < BUFFER_SIZE;
    i++
  ) {

    int index =
      (
        dataIndex +
        i
      )
      %
      BUFFER_SIZE;


    float value =
      rawData[index];


    float y =
      map(
        value,
        rawMin,
        rawMax,

        rawGraphY +
        graphHeight -
        8,

        rawGraphY +
        8
      );


    y =
      constrain(
        y,
        rawGraphY + 5,

        rawGraphY +
        graphHeight -
        5
      );


    float x =
      map(
        i,
        0,
        BUFFER_SIZE - 1,

        graphX,
        graphX +
        graphWidth
      );


    vertex(
      x,
      y
    );
  }


  endShape();
}


