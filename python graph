import csv
import os
import sys
import time
import matplotlib

matplotlib.use("TkAgg")  # GUI Window Backend
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import serial
from scipy.signal import find_peaks

# =====================================================
# CONFIGURATION
# =====================================================
PORT_NAME = "COM8"  # Confirm your COM Port
BAUD_RATE = 115200
SAMPLE_RATE = 250.0  # Hz
RECORD_DURATION = 10  # 10 Seconds Recording per lead
TARGET_BEATS = 5  # Show exactly 5 beats in display window

RECORDING_SEQUENCE = [
    ("Lead I", "lead1_data.csv"),
    ("Lead II", "lead2_data.csv"),
    ("Lead V1", "lead_v1_data.csv"),
    ("Lead V2", "lead_v2_data.csv"),
    ("Lead V3", "lead_v3_data.csv"),
    ("Lead V4", "lead_v4_data.csv"),
    ("Lead V5", "lead_v5_data.csv"),
    ("Lead V6", "lead_v6_data.csv"),
]

COMBINED_FILE = "all_12_leads_data.csv"

# =====================================================
# 1. DATA COLLECTION FUNCTION
# =====================================================


def record_lead(lead_name, filename, duration_sec):
    print(
        f"\n=================================================================="
    )
    print(f" READY TO RECORD: {lead_name}")
    print(
        f" -> Press ENTER to start recording {lead_name} ({duration_sec}s)"
    )
    print(
        f" -> Type 'skip' (or 's') and press ENTER to skip this lead"
    )
    print(
        f"=================================================================="
    )

    user_choice = input("Your choice: ").strip().lower()

    if user_choice in ["skip", "s"]:
        print(f"[SKIPPED] Skipped recording for {lead_name}.")
        if os.path.exists(filename):
            os.remove(filename)
        return False

    print(f"[INFO] Connecting to {PORT_NAME}...")
    try:
        ser = serial.Serial(PORT_NAME, BAUD_RATE, timeout=1)
        ser.flushInput()
        time.sleep(1.5)
        print(
            f"[SUCCESS] Connected! Recording {lead_name} for {duration_sec} seconds..."
        )
    except Exception as e:
        print(f"[ERROR] Could not open port {PORT_NAME}: {e}")
        print("Make sure Serial Monitor / Arduino IDE is CLOSED.")
        sys.exit(1)

    total_samples = int(SAMPLE_RATE * duration_sec)
    sample_count = 0

    with open(filename, mode="w", newline="") as file:
        writer = csv.writer(file)
        writer.writerow(["Sample", "Raw", "Filtered"])

        start_time = time.time()
        while sample_count < total_samples:
            if ser.in_waiting > 0:
                try:
                    line = (
                        ser.readline().decode("utf-8", errors="ignore").strip()
                    )
                    if not line:
                        continue

                    raw_val, filt_val = 0.0, 0.0

                    if "," in line:
                        parts = line.replace(">", "").split(",")
                        raw_val = float(parts[0])
                        filt_val = (
                            float(parts[1])
                            if len(parts) > 1
                            else float(parts[0])
                        )
                    else:
                        clean_val = (
                            line.replace(">", "")
                            .replace("raw:", "")
                            .replace("filtered:", "")
                        )
                        raw_val = float(clean_val)
                        filt_val = raw_val

                    writer.writerow([sample_count, raw_val, filt_val])
                    file.flush()
                    sample_count += 1

                    if sample_count % 250 == 0:
                        elapsed = int(time.time() - start_time)
                        print(
                            f"[{lead_name}] Recorded: {sample_count}/{total_samples} samples ({elapsed}/{duration_sec}s)"
                        )

                except ValueError:
                    continue

    ser.close()
    print(f"[COMPLETE] {lead_name} saved to '{filename}' successfully!\n")
    return True


# =====================================================
# 2. BEAT-BASED PLOTTING FUNCTION (5 BEATS SCALE)
# =====================================================


def process_and_plot_available():
    print("\n[INFO] Processing available recorded CSV files...")

    recorded_signals = {}

    for name, filename in RECORDING_SEQUENCE:
        if os.path.exists(filename):
            try:
                df = pd.read_csv(filename)
                df.columns = df.columns.str.strip()
                col = "Filtered" if "Filtered" in df.columns else df.columns[-1]
                data = pd.to_numeric(df[col], errors="coerce").fillna(0).values
                if len(data) > 0:
                    recorded_signals[name] = data
            except Exception as e:
                print(f"[WARNING] Could not read {filename}: {e}")

    if not recorded_signals:
        print("[ERROR] No leads were recorded! Cannot generate graph.")
        return

    min_len = min(len(data) for data in recorded_signals.values())
    time_axis = np.arange(min_len) / SAMPLE_RATE

    all_plots = []
    combined_dict = {"Sample": np.arange(min_len), "Time_sec": time_axis}

    # 1. Lead I
    if "Lead I" in recorded_signals:
        l1 = recorded_signals["Lead I"][:min_len]
        all_plots.append((l1, "Lead_I"))
        combined_dict["Lead_I"] = l1

    # 2. Lead II
    if "Lead II" in recorded_signals:
        l2 = recorded_signals["Lead II"][:min_len]
        all_plots.append((l2, "Lead_II"))
        combined_dict["Lead_II"] = l2

    # 3. Derived Limb Leads
    if "Lead I" in recorded_signals and "Lead II" in recorded_signals:
        l1 = recorded_signals["Lead I"][:min_len]
        l2 = recorded_signals["Lead II"][:min_len]

        l3 = l2 - l1
        avr = -(l1 + l2) / 2.0
        avl = l1 - (l2 / 2.0)
        avf = l2 - (l1 / 2.0)

        all_plots.extend(
            [(l3, "Lead_III"), (avr, "aVR"), (avl, "aVL"), (avf, "aVF")]
        )
        combined_dict.update({
            "Lead_III": l3,
            "aVR": avr,
            "aVL": avl,
            "aVF": avf,
        })

    # 4. Precordial Leads
    for v_name in [
        "Lead V1",
        "Lead V2",
        "Lead V3",
        "Lead V4",
        "Lead V5",
        "Lead V6",
    ]:
        if v_name in recorded_signals:
            v_data = recorded_signals[v_name][:min_len]
            clean_title = v_name.replace("Lead ", "")
            all_plots.append((v_data, clean_title))
            combined_dict[clean_title] = v_data

    # Export to Combined File
    df_combined = pd.DataFrame(combined_dict)
    df_combined.to_csv(COMBINED_FILE, index=False)
    print(f"[SUCCESS] Recorded dataset saved to '{COMBINED_FILE}'")

    num_plots = len(all_plots)

    # 3x4 Layout Setup
    cols = 4 if num_plots >= 4 else num_plots
    rows = (num_plots + cols - 1) // cols

    plt.style.use("default")
    fig, axes = plt.subplots(rows, cols, figsize=(16, 9))
    fig.canvas.manager.set_window_title("12-Lead ECG Summary Report")
    fig.suptitle(
        "12-Lead ECG Summary Report", fontsize=18, fontweight="bold", y=0.96
    )

    if num_plots == 1:
        axes_flat = [axes]
    else:
        axes_flat = axes.flatten()

    for i, (data, title) in enumerate(all_plots):
        ax = axes_flat[i]

        # Plot ECG Line
        ax.plot(time_axis, data, color="black", linewidth=1.1)
        ax.set_title(
            title, loc="left", fontsize=11, fontweight="bold", color="darkblue"
        )

        # Medical Grid Background
        ax.set_facecolor("white")
        ax.grid(
            True, which="major", color="#ffb3b3", linestyle="-", linewidth=0.7
        )
        ax.grid(
            True, which="minor", color="#ffe6e6", linestyle="-", linewidth=0.4
        )
        ax.minorticks_on()

        # Dynamic 5-Beat Peak Detection Logic
        peaks, _ = find_peaks(
            data,
            distance=int(SAMPLE_RATE * 0.4),
            prominence=np.std(data) * 0.6,
        )

        if len(peaks) >= TARGET_BEATS:
            # First peak se thoda pehle (0.2s) Start, aur 5th peak ke thoda baad (0.3s) End
            start_idx = max(0, int(peaks[0] - SAMPLE_RATE * 0.2))
            end_idx = min(
                len(data) - 1, int(peaks[TARGET_BEATS - 1] + SAMPLE_RATE * 0.3)
            )

            x_min = time_axis[start_idx]
            x_max = time_axis[end_idx]
            sub_data = data[start_idx:end_idx]
        else:
            # Fallback agar peaks na milein (default 4 seconds view)
            x_min = 0.0
            x_max = min(4.0, time_axis[-1])
            sub_data = data[: int(x_max * SAMPLE_RATE)]

        # Set X-Axis to exact 5 Beats
        ax.set_xlim(x_min, x_max)

        # Auto Y-Axis Scaling for the 5-beat window
        if len(sub_data) > 0:
            d_min, d_max = np.min(sub_data), np.max(sub_data)
            margin = max((d_max - d_min) * 0.15, 15)
            ax.set_ylim(d_min - margin, d_max + margin)

        ax.set_xticklabels([])
        ax.set_yticklabels([])

    # Hide unused subplots
    for j in range(num_plots, len(axes_flat)):
        fig.delaxes(axes_flat[j])

    plt.tight_layout(rect=[0, 0, 1, 0.94])
    plt.show(block=True)


# =====================================================
# MAIN PIPELINE
# =====================================================
if __name__ == "__main__":
    for lead_label, file_path in RECORDING_SEQUENCE:
        record_lead(lead_label, file_path, RECORD_DURATION)

    process_and_plot_available()
